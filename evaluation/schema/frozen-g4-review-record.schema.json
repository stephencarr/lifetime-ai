{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifetime-ai.local/schema/frozen-g4-review-record-v1.json",
  "title": "Blind frozen G4 corpus review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "blind_to_model_predictions", "reviewers",
    "history_approvals", "review_findings", "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "blind_to_model_predictions": {"const": true},
    "reviewers": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reviewer_id", "scope", "disposition"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["pass", "revise"]}
        }
      }
    },
    "history_approvals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "history_id", "reviewed_content_sha256", "reviewed_pair_ids",
          "reviewer_ids", "disposition"
        ],
        "properties": {
          "history_id": {"type": "string", "minLength": 1},
          "reviewed_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reviewed_pair_ids": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "uniqueItems": true, "items": {"type": "string", "minLength": 1}
          },
          "reviewer_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "disposition": {"enum": ["approved", "revise"]}
        }
      }
    },
    "review_findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "status", "summary"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "resolved", "rejected"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
